<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>WeaponModelChanger</AssemblyName>
    <RootNamespace>WeaponModelChanger</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- 与线上 CounterStrikeSharp 一致（NuGet 最新正式版，2026-09-27 发布） -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376" />
    <!-- WASD 菜单（NuGet 最新正式版） -->
    <PackageReference Include="CS2MenuManager" Version="1.0.43" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>
</Project>
